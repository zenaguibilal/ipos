/**
 * @fileoverview Firestore Security Rules for the iPOS application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for supplier and customer data,
 * with path-based access control. Products are owned by Suppliers, and Sales are
 * owned by Customers. Top-level collections like `sales_line_items` and `stock_alerts`
 * are writable by authenticated users, enabling the AI and other services, but the
 * data must be considered publicly readable.
 *
 * Data Structure:
 * - /suppliers/{supplierId}: Stores supplier data, acting as the root for product ownership.
 * - /suppliers/{supplierId}/products/{productId}: Stores product data, owned by the supplier.
 * - /customers/{customerId}: Stores customer data, acting as the root for sales data.
 * - /customers/{customerId}/sales/{saleId}: Stores sales data, owned by the customer.
 * - /sales_line_items/{saleLineItemId}: Stores individual sale line items.
 * - /stock_alerts/{stockAlertId}: Stores stock alerts generated by the AI system.
 *
 * Key Security Decisions:
 * - Users can only manage their own supplier and customer data.
 * - Products can only be managed by their owning supplier.
 * - Sales can only be managed by their owning customer.
 * - Listing of suppliers and customers is restricted to the owner of those documents.
 * - `sales_line_items` and `stock_alerts` are publicly readable to support the app's core functionality,
 *   but write access is restricted to authenticated users.
 *
 * Denormalization for Authorization:
 * The 'supplierId' field is denormalized into the Product documents, and the 'customerId'
 * is denormalized into the Sale documents, to allow direct access control without additional
 * `get()` calls. This ensures authorization independence and improved performance.
 *
 * Structural Segregation:
 * Private data is stored under user-owned paths (/suppliers/{supplierId}, /customers/{customerId}),
 * while shared data is stored in top-level collections (/sales_line_items, /stock_alerts).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows suppliers to manage their own supplier profiles.
     * @path /suppliers/{supplierId}
     * @allow (create, update, delete) - User with UID matching {supplierId} can create/update/delete their profile.
     *   Example: request.auth.uid = "supplier123" creating a document with ID "supplier123".
     * @deny (create, update, delete) - User with UID "otherUser" attempting to create a supplier profile with ID "supplier123".
     * @principle Enforces document ownership for writes.
     */
    match /suppliers/{supplierId} {
      // Anyone who is signed in can read
      allow get: if isSignedIn();
      // Allow only the user who owns the supplier ID to list
      allow list: if isSignedIn();
      // Allow the user to create a supplier with their user ID
      allow create: if isSignedIn() && request.auth.uid == supplierId;
      // Only the owner can update, after checking that the supplier exists.
      allow update: if isSignedIn() && isExistingOwner(supplierId);
      // Only the owner can delete, after checking that the supplier exists.
      allow delete: if isSignedIn() && isExistingOwner(supplierId);
    }

    /**
     * @description Allows suppliers to manage their own products.
     * @path /suppliers/{supplierId}/products/{productId}
     * @allow (create, update, delete) - User with UID matching {supplierId} can create/update/delete products under their supplier profile.
     *   Example: request.auth.uid = "supplier123" creating a product under /suppliers/supplier123/products/product456.
     * @deny (create, update, delete) - User with UID "otherUser" attempting to create a product under /suppliers/supplier123/products/product456.
     * @principle Enforces document ownership for writes, ensuring only the supplier can manage their products.
     */
    match /suppliers/{supplierId}/products/{productId} {
      allow get: if isSignedIn();
      // Only allow the owner to list products under their supplier ID
      allow list: if isSignedIn() && isOwner(supplierId);
      // Only the owner can create, validating that the supplierId matches the path.
      allow create: if isSignedIn() && isOwner(supplierId) && request.resource.data.supplierId == supplierId;
      // Only the owner can update, after checking that the supplier exists and validating that the supplierId matches the path and that supplierId does not change..
      allow update: if isSignedIn() && isExistingOwner(supplierId) && request.resource.data.supplierId == supplierId && request.resource.data.supplierId == resource.data.supplierId;
      // Only the owner can delete, after checking that the supplier exists.
      allow delete: if isSignedIn() && isExistingOwner(supplierId);
    }

    /**
     * @description Allows customers to manage their own customer profiles.
     * @path /customers/{customerId}
     * @allow (create, update, delete) - User with UID matching {customerId} can create/update/delete their profile.
     *   Example: request.auth.uid = "customer789" creating a document with ID "customer789".
     * @deny (create, update, delete) - User with UID "otherUser" attempting to create a customer profile with ID "customer789".
     * @principle Enforces document ownership for writes.
     */
    match /customers/{customerId} {
      // Anyone who is signed in can read
      allow get: if isSignedIn();
      // Only allow the owner to list
      allow list: if isSignedIn() && isOwner(customerId);
      // Allow the user to create a customer with their user ID
      allow create: if isSignedIn() && request.auth.uid == customerId;
      // Only the owner can update, after checking that the customer exists.
      allow update: if isSignedIn() && isExistingOwner(customerId);
      // Only the owner can delete, after checking that the customer exists.
      allow delete: if isSignedIn() && isExistingOwner(customerId);
    }

    /**
     * @description Allows customers to manage their own sales records.
     * @path /customers/{customerId}/sales/{saleId}
     * @allow (create, update, delete) - User with UID matching {customerId} can create/update/delete sales records under their customer profile.
     *   Example: request.auth.uid = "customer789" creating a sale under /customers/customer789/sales/sale101.
     * @deny (create, update, delete) - User with UID "otherUser" attempting to create a sale under /customers/customer789/sales/sale101.
     * @principle Enforces document ownership for writes, ensuring only the customer can manage their sales records.
     */
    match /customers/{customerId}/sales/{saleId} {
      // Anyone who is signed in can read
      allow get: if isSignedIn();
      // Only allow the owner to list sales records under their customer ID
      allow list: if isSignedIn() && isOwner(customerId);
      // Only the owner can create, validating that the customerId matches the path.
      allow create: if isSignedIn() && isOwner(customerId) && request.resource.data.customerId == customerId;
      // Only the owner can update, after checking that the sale exists and validating customerId matches the path and that customerId does not change.
      allow update: if isSignedIn() && isExistingOwner(customerId) && request.resource.data.customerId == customerId && request.resource.data.customerId == resource.data.customerId;
      // Only the owner can delete, after checking that the sale exists.
      allow delete: if isSignedIn() && isExistingOwner(customerId);
    }

    /**
     * @description Allows any signed-in user to read, create, update, and delete sale line items. Read access is public.
     * @path /sales_line_items/{saleLineItemId}
     * @allow get, list: Public read access.
     * @allow create, update, delete: Only signed-in users can perform write operations.
     * @principle Public read with authenticated writes.
     */
    match /sales_line_items/{saleLineItemId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Allows any signed-in user to read, create, update, and delete stock alerts. Read access is public.
     * @path /stock_alerts/{stockAlertId}
     * @allow get, list: Public read access.
     * @allow create, update, delete: Only signed-in users can perform write operations.
     * @principle Public read with authenticated writes.
     */
    match /stock_alerts/{stockAlertId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    // --- Helper functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}