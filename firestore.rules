
/**
 * @fileoverview Firestore Security Rules for the iPOS application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. Each user can only access their own data.
 * All user-specific data is nested under their user document.
 *
 * Data Structure:
 * /users/{userId} - User profile information.
 * /users/{userId}/products/{productId} - Products created by the user.
 * /users/{userId}/sales/{saleId} - Sales recorded by the user.
 * /users/{userId}/companyProfile/main - Singleton for company information.
 * /users/{userId}/stockIntakes/{stockIntakeId} - Records of stock received.
 * /users/{userId}/purchaseOrders/{purchaseOrderId} - Purchase orders created by the user.
 *
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if the user is the owner of the document
    // It compares the `userId` from the path with the authenticated user's UID.
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
      
    match /users/{userId} {
      // Allow a user to create their own document if the document ID matches their auth UID.
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      // Allow a user to read, update, and delete their own document.
      allow read, update, delete: if isOwner(userId);
        
      // Rules for the 'products' subcollection nested under a user document.
      match /products/{productId} {
        // Only the owner of the parent user document can read or write to the products subcollection.
        allow read, write: if isOwner(userId);
      }

      // Rules for the 'sales' subcollection nested under a user document.
      match /sales/{saleId} {
        // Allow the owner to read/write individual documents and list the collection.
        allow read, write: if isOwner(userId);
      }

       // Rules for the 'customers' subcollection.
      match /customers/{customerId} {
        allow read, write: if isOwner(userId);
      }

      // Rules for the 'payments' subcollection.
      match /payments/{paymentId} {
        allow read, write: if isOwner(userId);
      }

      // Rules for the 'breadOrders' subcollection.
      match /breadOrders/{orderId} {
        allow read, write: if isOwner(userId);
      }
      
      // Rules for the 'companyProfile' subcollection.
      match /companyProfile/{docId} {
         // Only the owner can read or write their company profile.
        allow read, write: if isOwner(userId);
      }

      // Rules for the 'stockIntakes' subcollection.
      match /stockIntakes/{stockIntakeId} {
        // Only the owner of the parent user document can read or write to the stock intakes subcollection.
        allow read, write: if isOwner(userId);
      }
      
      // Rules for the 'purchaseOrders' subcollection.
      match /purchaseOrders/{purchaseOrderId} {
        // Only the owner of the parent user document can read or write to the purchase orders subcollection.
        allow read, write: if isOwner(userId);
      }

      // Rules for the 'returns' subcollection.
      match /returns/{returnId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
