
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user in the iPOS system.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user entity."
        },
        "firstName": {
          "type": "string",
          "description": "First name of the user."
        },
        "lastName": {
          "type": "string",
          "description": "Last name of the user."
        },
        "email": {
          "type": "string",
          "description": "Email address of the user.",
          "format": "email"
        },
        "phone": {
          "type": "string",
          "description": "Phone number of the user."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the user account was created.",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp indicating when the user account was last updated.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "firstName",
        "lastName",
        "email",
        "createdAt",
        "updatedAt"
      ]
    },
    "Product": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Product",
      "type": "object",
      "description": "Represents a product in the inventory.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the product."
        },
        "category": {
            "type": "string",
            "description": "Category of the product."
        },
        "price": {
          "type": "number",
          "description": "Selling price of the product."
        },
        "purchasePrice": {
          "type": "number",
          "description": "Purchase price of the product."
        },
        "quantity": {
          "type": "number",
          "description": "Quantity in stock."
        },
        "minStockLevel": {
          "type": "integer",
          "description": "Minimum stock level for alert."
        },
        "barcodes": {
          "type": "array",
          "description": "A list of barcodes (UPC, EAN, etc.) for the product.",
          "items": {
            "type": "string"
          }
        },
        "imageUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL of the product image."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the product was created.",
          "format": "date-time"
        }
      },
      "required": [
        "name",
        "price",
        "purchasePrice",
        "quantity",
        "minStockLevel",
        "createdAt"
      ]
    },
     "Customer": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Customer",
      "type": "object",
      "description": "Represents a customer.",
      "properties": {
        "firstName": {
          "type": "string",
          "description": "First name of the customer."
        },
        "lastName": {
          "type": "string",
          "description": "Last name of the customer."
        },
        "phone": {
          "type": "string",
          "description": "Phone number of the customer."
        },
        "settlementDay": {
            "type": "integer",
            "description": "The day of the month the customer typically settles their debts."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the customer was added.",
          "format": "date-time"
        }
      },
      "required": ["firstName", "lastName", "createdAt"]
    },
    "Sale": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Sale",
      "type": "object",
      "description": "Represents a single sales transaction.",
      "properties": {
        "invoiceNumber": {
          "type": "string",
          "description": "Unique identifier for the sales invoice."
        },
        "items": {
          "type": "array",
          "description": "List of items included in the sale.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "price": {
                "type": "number"
              },
              "purchasePrice": {
                "type": "number",
                "description": "Purchase price of the item."
              },
              "quantity": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "name",
              "price",
              "quantity"
            ]
          }
        },
        "subtotal": {
            "type": "number",
            "description": "The total amount of the sale before discounts."
        },
        "discountType": {
            "type": "string",
            "description": "The type of discount applied.",
            "enum": ["percentage", "fixed"]
        },
        "discountAmount": {
            "type": "number",
            "description": "The calculated monetary value of the discount applied."
        },
        "total": {
          "type": "number",
          "description": "The final total amount of the sale after discounts."
        },
        "amountPaid": {
          "type": "number",
          "description": "The amount paid by the customer for this specific transaction."
        },
        "remainingBalance": {
          "type": "number",
          "description": "The outstanding balance for this specific sale (total - amountPaid)."
        },
        "paymentStatus": {
          "type": "string",
          "description": "The payment status of the sale.",
          "enum": ["paid", "partial", "unpaid"]
        },
        "payments": {
            "type": "array",
            "description": "A list of payments made for this sale, allowing for split payments.",
            "items": {
                "type": "object",
                "properties": {
                    "method": {
                        "type": "string",
                        "description": "The payment method used for this part of the payment.",
                        "enum": ["cash", "card", "other"]
                    },
                    "amount": {
                        "type": "number",
                        "description": "The amount paid with this method."
                    }
                },
                "required": ["method", "amount"]
            }
        },
        "customerId": {
          "type": "string",
          "description": "Optional ID of the customer associated with the sale."
        },
        "customerName": {
            "type": "string",
            "description": "Optional name of the customer for quick reference."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the sale occurred.",
          "format": "date-time"
        },
        "breadOrderDate": {
          "type": "string",
          "format": "date",
          "description": "The date of the bread order this sale corresponds to, in YYYY-MM-DD format."
        }
      },
      "required": [
        "invoiceNumber",
        "items",
        "subtotal",
        "total",
        "amountPaid",
        "remainingBalance",
        "paymentStatus",
        "payments",
        "createdAt"
      ]
    },
    "Payment": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Payment",
      "description": "Represents a standalone payment made by a customer to settle their debt.",
      "type": "object",
      "properties": {
        "customerId": {
          "type": "string",
          "description": "The ID of the customer making the payment."
        },
        "customerName": {
          "type": "string",
          "description": "Name of the customer for quick reference."
        },
        "amount": {
          "type": "number",
          "description": "The amount paid."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp indicating when the payment was recorded."
        }
      },
      "required": ["customerId", "amount", "createdAt"]
    },
    "CompanyProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Company Profile",
      "type": "object",
      "description": "Represents the user's company information.",
      "properties": {
        "companyName": {
          "type": "string",
          "description": "Name of the company."
        },
        "address": {
          "type": "string",
          "description": "Company's street address."
        },
        "city": {
          "type": "string",
          "description": "City where the company is located."
        },
        "zipCode": {
          "type": "string",
          "description": "Postal or ZIP code."
        },
        "country": {
          "type": "string",
          "description": "Country where the company is located."
        },
        "phone": {
          "type": "string",
          "description": "Company's phone number."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Official email address of the company."
        },
        "website": {
          "type": "string",
          "format": "uri",
          "description": "Company's official website URL."
        },
        "vatNumber": {
          "type": "string",
          "description": "VAT (Value Added Tax) identification number."
        },
        "rcNumber": {
          "type": "string",
          "description": "Trade Register (Registre du Commerce) number."
        },
        "breadPrice": {
          "type": "number",
          "description": "The selling price for one unit of bread."
        },
        "breadPurchasePrice": {
          "type": "number",
          "description": "The purchase price for one unit of bread."
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp indicating when the profile was last updated.",
          "format": "date-time"
        }
      }
    },
    "PurchaseOrder": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Purchase Order",
      "description": "Represents a purchase order sent to a supplier.",
      "type": "object",
      "properties": {
        "poNumber": {
          "type": "string",
          "description": "Unique identifier for the purchase order."
        },
        "supplier": {
          "type": "string",
          "description": "Name of the supplier."
        },
        "items": {
          "type": "array",
          "description": "List of products to order.",
          "items": {
            "type": "object",
            "properties": {
              "productId": { "type": "string" },
              "productName": { "type": "string" },
              "quantity": { "type": "number" },
              "purchasePrice": { "type": "number" }
            },
            "required": ["productId", "productName", "quantity", "purchasePrice"]
          }
        },
        "totalValue": {
            "type": "number",
            "description": "The total estimated value of the purchase order."
        },
        "status": {
            "type": "string",
            "enum": ["pending", "received"],
            "description": "The status of the purchase order."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp indicating when this PO was created."
        }
      },
      "required": ["poNumber", "supplier", "items", "totalValue", "status", "createdAt"]
    },
     "StockIntake": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Stock Intake",
      "description": "Represents a record of stock being received from a supplier.",
      "type": "object",
      "properties": {
        "supplier": {
          "type": "string",
          "description": "The name of the supplier for this intake."
        },
        "invoiceNumber": {
          "type": "string",
          "description": "The supplier's invoice number for this delivery."
        },
        "invoiceDate": {
          "type": "string",
          "format": "date-time",
          "description": "The date on the supplier's invoice."
        },
        "items": {
          "type": "array",
          "description": "List of items received.",
          "items": {
            "type": "object",
            "properties": {
              "productId": { "type": "string", "description": "ID of the product if it existed before this intake." },
              "productName": { "type": "string" },
              "quantityReceived": { "type": "number" },
              "purchasePrice": { "type": "number", "description": "The purchase price at the time of this intake." }
            },
            "required": ["productName", "quantityReceived", "purchasePrice"]
          }
        },
        "totalValue": {
          "type": "number",
          "description": "The total value of the received stock based on purchase prices."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp indicating when this intake was recorded in the system."
        }
      },
      "required": ["supplier", "invoiceNumber", "invoiceDate", "items", "totalValue", "createdAt"]
    },
    "ProductReturn": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Product Return",
      "description": "Represents a customer product return transaction.",
      "type": "object",
      "properties": {
        "originalSaleId": {
          "type": "string",
          "description": "The ID of the original sale this return is associated with."
        },
        "originalInvoiceNumber": {
          "type": "string",
          "description": "The invoice number of the original sale for easy reference."
        },
        "items": {
          "type": "array",
          "description": "List of items being returned.",
          "items": {
            "type": "object",
            "properties": {
              "productId": { "type": ["string", "null"] },
              "productName": { "type": "string" },
              "quantity": { "type": "number" },
              "price": { "type": "number", "description": "The price at which the item was sold." },
              "purchasePrice": { "type": "number", "description": "The purchase price of the item at the time of the original sale." },
              "wasRestocked": {
                "type": "boolean",
                "description": "Indicates if the item's quantity was added back to the main product stock during the return."
              }
            },
            "required": ["productId", "productName", "quantity", "price", "purchasePrice", "wasRestocked"]
          }
        },
        "totalReturnValue": {
            "type": "number",
            "description": "The total value of the returned items."
        },
        "amountRefunded": {
            "type": "number",
            "description": "The actual amount refunded to the customer."
        },
        "customerId": {
          "type": "string",
          "description": "ID of the customer who returned the items."
        },
        "customerName": {
            "type": "string",
            "description": "Name of the customer for quick reference."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp indicating when the return was processed."
        },
        "notes": {
            "type": "string",
            "description": "Additional notes about the return."
        }
      },
      "required": ["originalInvoiceNumber", "items", "totalReturnValue", "amountRefunded", "createdAt"]
    },
    "BreadCustomer": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Bread Customer",
      "description": "A customer with a recurring daily bread order.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the customer." },
        "isActive": { "type": "boolean", "description": "Whether the customer is currently active." },
        "defaultOrderQuantity": { "type": "number", "description": "The default quantity of bread they order." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the customer was added."}
      },
      "required": ["name", "isActive", "defaultOrderQuantity", "createdAt"]
    },
    "DailyBreadOrder": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Daily Bread Order",
      "description": "Represents a modification or status update to a bread customer's order for a specific day.",
      "type": "object",
      "properties": {
        "breadCustomerId": { "type": "string", "description": "The ID of the recurring bread customer." },
        "customerName": { "type": "string", "description": "The name of the customer for quick reference." },
        "quantity": { "type": "number", "description": "The quantity of bread ordered for this specific day." },
        "date": { "type": "string", "format": "date", "description": "The date of the order in YYYY-MM-DD format." },
        "isPaid": { "type": "boolean", "description": "Whether this specific day's order has been paid for." },
        "isDelivered": { "type": "boolean", "description": "Whether this specific day's order has been delivered." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of when this daily record was created/updated."},
        "saleId": { "type": "string", "description": "The ID of the sale generated when this order is paid." }
      },
      "required": ["breadCustomerId", "customerName", "quantity", "date", "isPaid", "isDelivered", "createdAt"]
    }
  },
  "auth": {
    "providers": ["email", "google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "User profile information."
    },
    "/users/{userId}/products/{productId}": {
      "schema": {
        "$ref": "#/entities/Product"
      },
      "description": "Products created by the user."
    },
    "/users/{userId}/customers/{customerId}": {
      "schema": {
        "$ref": "#/entities/Customer"
      },
      "description": "Customers of the user."
    },
    "/users/{userId}/sales/{saleId}": {
      "schema": {
        "$ref": "#/entities/Sale"
      },
      "description": "Sales recorded by the user."
    },
    "/users/{userId}/payments/{paymentId}": {
        "schema": { "$ref": "#/entities/Payment" },
        "description": "Standalone payments recorded for customers."
    },
    "/users/{userId}/companyProfile/main": {
      "schema": {
        "$ref": "#/entities/CompanyProfile"
      },
      "description": "Singleton document for the user's company profile."
    },
    "/users/{userId}/purchaseOrders/{purchaseOrderId}": {
        "schema": { "$ref": "#/entities/PurchaseOrder" },
        "description": "Purchase orders created by the user."
    },
    "/users/{userId}/stockIntakes/{stockIntakeId}": {
      "schema": {
        "$ref": "#/entities/StockIntake"
      },
      "description": "Records of stock received by the user."
    },
    "/users/{userId}/returns/{returnId}": {
      "schema": {
        "$ref": "#/entities/ProductReturn"
      },
      "description": "Product returns processed by the user."
    },
    "/users/{userId}/breadCustomers/{breadCustomerId}": {
      "schema": {
        "$ref": "#/entities/BreadCustomer"
      },
      "description": "Recurring bread customers."
    },
    "/users/{userId}/dailyBreadOrders/{dailyBreadOrderId}": {
      "schema": {
        "$ref": "#/entities/DailyBreadOrder"
      },
      "description": "Daily overrides and status for bread orders."
    }
  }
}
