{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user in the iPOS system.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user entity."
        },
        "firstName": {
          "type": "string",
          "description": "First name of the user."
        },
        "lastName": {
          "type": "string",
          "description": "Last name of the user."
        },
        "email": {
          "type": "string",
          "description": "Email address of the user.",
          "format": "email"
        },
        "phone": {
          "type": "string",
          "description": "Phone number of the user."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the user account was created.",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp indicating when the user account was last updated.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "firstName",
        "lastName",
        "email",
        "createdAt",
        "updatedAt"
      ]
    },
    "Product": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Product",
      "type": "object",
      "description": "Represents a product in the inventory.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the product."
        },
        "price": {
          "type": "number",
          "description": "Price of the product."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the product was created.",
          "format": "date-time"
        }
      },
      "required": [
        "name",
        "price",
        "createdAt"
      ]
    },
    "Sale": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Sale",
      "type": "object",
      "description": "Represents a single sales transaction.",
      "properties": {
        "items": {
          "type": "array",
          "description": "List of items included in the sale.",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "price": { "type": "number" },
              "quantity": { "type": "integer" }
            },
            "required": ["id", "name", "price", "quantity"]
          }
        },
        "total": {
          "type": "number",
          "description": "Total amount of the sale."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the sale was made.",
          "format": "date-time"
        }
      },
      "required": [
        "items",
        "total",
        "createdAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "user",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Stores user profile information. Uses path-based ownership for user data security.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier for the user."
            }
          ]
        }
      },
      {
        "path": "/users/{userId}/products/{productId}",
        "definition": {
          "schema": { "$ref": "#/backend/entities/Product" },
          "description": "Products owned by a specific user."
        }
      },
      {
        "path": "/users/{userId}/sales/{saleId}",
        "definition": {
          "schema": { "$ref": "#/backend/entities/Sale" },
          "description": "Sales records for a specific user."
        }
      }
    ],
    "reasoning": "This design prioritizes simplicity and security for the iPOS application. We use path-based ownership for user data and avoid hierarchical authorization dependencies by storing all data directly under the user's document, ensuring authorization independence. This structure enables secure `list` operations. This approach streamlines security rule creation and enhances maintainability."
  }
}
