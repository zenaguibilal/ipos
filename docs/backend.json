{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user in the iPOS system.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user entity."
        },
        "firstName": {
          "type": "string",
          "description": "First name of the user."
        },
        "lastName": {
          "type": "string",
          "description": "Last name of the user."
        },
        "email": {
          "type": "string",
          "description": "Email address of the user.",
          "format": "email"
        },
        "phone": {
          "type": "string",
          "description": "Phone number of the user."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the user account was created.",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp indicating when the user account was last updated.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "firstName",
        "lastName",
        "email",
        "createdAt",
        "updatedAt"
      ]
    },
    "Product": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Product",
      "type": "object",
      "description": "Represents a product in the inventory.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the product."
        },
        "price": {
          "type": "number",
          "description": "Price of the product."
        },
        "barcode": {
          "type": "string",
          "description": "Barcode (UPC, EAN, etc.) of the product."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the product was created.",
          "format": "date-time"
        }
      },
      "required": [
        "name",
        "price",
        "createdAt"
      ]
    },
    "Sale": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Sale",
      "type": "object",
      "description": "Represents a single sales transaction.",
      "properties": {
        "items": {
          "type": "array",
          "description": "List of items included in the sale.",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "price": { "type": "number" },
              "quantity": { "type": "integer" }
            },
            "required": ["id", "name", "price", "quantity"]
          }
        },
        "total": {
          "type": "number",
          "description": "Total amount of the sale."
        },
        "customerId": {
          "type": "string",
          "description": "ID of the customer associated with the sale."
        },
        "customerName": {
          "type": "string",
          "description": "Name of the customer associated with the sale, for easy display."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the sale was made.",
          "format": "date-time"
        }
      },
      "required": [
        "items",
        "total",
        "createdAt"
      ]
    },
    "Customer": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Customer",
      "type": "object",
      "description": "Represents a customer of the business.",
      "properties": {
        "firstName": {
          "type": "string",
          "description": "First name of the customer."
        },
        "lastName": {
          "type": "string",
          "description": "Last name of the customer."
        },
        "email": {
          "type": "string",
          "description": "Email address of the customer.",
          "format": "email"
        },
        "phone": {
          "type": "string",
          "description": "Phone number of the customer."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the customer was created.",
          "format": "date-time"
        }
      },
      "required": [
        "firstName",
        "lastName",
        "createdAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/User" },
      "description": "Stores user profile information. The document ID is the user's UID from Firebase Authentication, enforcing ownership."
    },
    "/users/{userId}/products/{productId}": {
      "schema": { "$ref": "#/backend/entities/Product" },
      "description": "The collection of products created by a specific user. Only the user can access their own products."
    },
    "/users/{userId}/sales/{saleId}": {
      "schema": { "$ref": "#/backend/entities/Sale" },
      "description": "The collection of sales records for a specific user. Only the user can access their own sales history."
    },
    "/users/{userId}/customers/{customerId}": {
      "schema": { "$ref": "#/backend/entities/Customer" },
      "description": "The collection of customers for a specific user. Only the user can access their own customer list."
    }
  }
}
