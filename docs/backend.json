{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user in the iPOS system.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user entity."
        },
        "firstName": {
          "type": "string",
          "description": "First name of the user."
        },
        "lastName": {
          "type": "string",
          "description": "Last name of the user."
        },
        "email": {
          "type": "string",
          "description": "Email address of the user.",
          "format": "email"
        },
        "phone": {
          "type": "string",
          "description": "Phone number of the user."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the user account was created.",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp indicating when the user account was last updated.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "firstName",
        "lastName",
        "email",
        "createdAt",
        "updatedAt"
      ]
    },
    "Product": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Product",
      "type": "object",
      "description": "Represents a product in the inventory.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the product."
        },
        "price": {
          "type": "number",
          "description": "Selling price of the product."
        },
        "purchasePrice": {
          "type": "number",
          "description": "Purchase price of the product."
        },
        "quantity": {
          "type": "integer",
          "description": "Quantity in stock."
        },
        "minStockLevel": {
          "type": "integer",
          "description": "Minimum stock level for alert."
        },
        "barcode": {
          "type": "string",
          "description": "Barcode (UPC, EAN, etc.) of the product."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the product was created.",
          "format": "date-time"
        }
      },
      "required": [
        "name",
        "price",
        "purchasePrice",
        "quantity",
        "minStockLevel",
        "createdAt"
      ]
    },
    "Sale": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Sale",
      "type": "object",
      "description": "Represents a single sales transaction.",
      "properties": {
        "invoiceNumber": {
          "type": "string",
          "description": "Unique identifier for the sales invoice."
        },
        "items": {
          "type": "array",
          "description": "List of items included in the sale.",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "price": { "type": "number" },
              "quantity": { "type": "integer" }
            },
            "required": ["id", "name", "price", "quantity"]
          }
        },
        "total": {
          "type": "number",
          "description": "Total amount of the sale."
        },
        "amountPaid": {
          "type": "number",
          "description": "The amount paid by the customer for this specific transaction."
        },
        "remainingBalance": {
          "type": "number",
          "description": "The outstanding balance for this specific sale (total - amountPaid)."
        },
        "paymentStatus": {
          "type": "string",
          "description": "The payment status of the sale.",
          "enum": ["paid", "partial", "unpaid"]
        },
        "customerId": {
          "type": "string",
          "description": "Optional ID of the customer associated with the sale."
        },
        "customerName": {
            "type": "string",
            "description": "Optional name of the customer for quick reference."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the sale occurred.",
          "format": "date-time"
        }
      },
      "required": [
        "invoiceNumber",
        "items",
        "total",
        "amountPaid",
        "remainingBalance",
        "paymentStatus",
        "createdAt"
      ]
    },
    "Customer": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Customer",
      "type": "object",
      "description": "Represents a customer.",
      "properties": {
        "firstName": {
          "type": "string",
          "description": "First name of the customer."
        },
        "lastName": {
          "type": "string",
          "description": "Last name of the customer."
        },
        "phone": {
          "type": "string",
          "description": "Phone number of the customer."
        },
        "settlementDay": {
          "type": "integer",
          "description": "The usual day of the month the customer settles their debt."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the customer was created.",
          "format": "date-time"
        }
      },
      "required": [
        "firstName",
        "lastName",
        "createdAt"
      ]
    },
    "Payment": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Payment",
      "type": "object",
      "description": "Represents a payment made by a customer to settle a debt.",
      "properties": {
        "amount": {
          "type": "number",
          "description": "The amount paid."
        },
        "customerId": {
          "type": "string",
          "description": "The ID of the customer making the payment."
        },
        "customerName": {
            "type": "string",
            "description": "The name of the customer for quick reference."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the payment was made.",
          "format": "date-time"
        }
      },
      "required": [
        "amount",
        "customerId",
        "createdAt"
      ]
    },
    "CompanyProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Company Profile",
      "type": "object",
      "description": "Represents the user's company information.",
      "properties": {
        "companyName": {
          "type": "string",
          "description": "Name of the company."
        },
        "address": {
          "type": "string",
          "description": "Company's street address."
        },
        "city": {
          "type": "string",
          "description": "City where the company is located."
        },
        "zipCode": {
          "type": "string",
          "description": "Postal or ZIP code."
        },
        "country": {
          "type": "string",
          "description": "Country where the company is located."
        },
        "phone": {
          "type": "string",
          "description": "Company's phone number."
        },
        "vatNumber": {
          "type": "string",
          "description": "VAT (Value Added Tax) identification number."
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp indicating when the profile was last updated.",
          "format": "date-time"
        }
      }
    },
     "BreadOrder": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Bread Order",
      "type": "object",
      "description": "Represents a simple bread order.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the order or customer."
        },
        "quantity": {
          "type": "integer",
          "description": "Number of bread units ordered."
        },
        "isPaid": {
          "type": "boolean",
          "description": "Indicates if the order has been paid for."
        },
        "isDelivered": {
          "type": "boolean",
          "description": "Indicates if the order has been delivered/picked up."
        },
        "isRecurring": {
          "type": "boolean",
          "description": "Indicates if the order is a daily recurring order."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the order was created.",
          "format": "date-time"
        }
      },
      "required": [
        "name",
        "quantity",
        "createdAt"
      ]
    }
  },
  "auth": {
    "providers": ["email"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "User profile information."
    },
    "/users/{userId}/products/{productId}": {
      "schema": {
        "$ref": "#/entities/Product"
      },
      "description": "Products created by the user."
    },
    "/users/{userId}/sales/{saleId}": {
      "schema": {
        "$ref": "#/entities/Sale"
      },
      "description": "Sales recorded by the user."
    },
    "/users/{userId}/customers/{customerId}": {
      "schema": {
        "$ref": "#/entities/Customer"
      },
      "description": "Customers created by the user."
    },
     "/users/{userId}/payments/{paymentId}": {
      "schema": {
        "$ref": "#/entities/Payment"
      },
      "description": "Payments made by customers to settle debts."
    },
    "/users/{userId}/companyProfile/main": {
      "schema": {
        "$ref": "#/entities/CompanyProfile"
      },
      "description": "Singleton document for the user's company profile."
    },
    "/users/{userId}/breadOrders/{breadOrderId}": {
      "schema": {
        "$ref": "#/entities/BreadOrder"
      },
      "description": "Bread orders placed by or for the user."
    }
  }
}
